{
  "name": "@tyconsa/bizuit-form-template",
  "version": "1.0.7",
  "description": "BIZUIT Custom Form Template - Base template for creating new forms with best practices",
  "author": "Tyconsa",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "node ../build-form.js ./src/index.tsx ./dist/form.js form-template",
    "build:all": "npm run build && npm run build:dev",
    "build:dev": "node ../build-form-dev.js ./src/index.tsx ./dist/form.dev.js form-template",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@sentry/react": "^9.0.0",
    "@tyconsa/bizuit-form-sdk": "^2.4.5",
    "@tyconsa/bizuit-ui-components": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.2"
  }
}
